# Environment Variables untuk Vercel Deployment
# Copy file ini ke Vercel Dashboard → Settings → Environment Variables

# Database Configuration (Required)
# Gunakan salah satu opsi:

# Option 1: Vercel Postgres (Recommended)
# https://vercel.com/docs/storage/vercel-postgres
DB_HOST=your-postgres-host.postgres.vercel-storage.com
DB_USER=default
DB_PASS=your-postgres-password
DB_NAME=verceldb
DB_PORT=5432

# Option 2: PlanetScale MySQL (Free Tier Available)
# https://planetscale.com/
# DB_HOST=aws.connect.psdb.cloud
# DB_USER=your-planetscale-user
# DB_PASS=your-planetscale-password
# DB_NAME=your-database-name
# DB_PORT=3306

# Option 3: Railway MySQL (Free Tier)
# https://railway.app/
# DB_HOST=containers-us-west-xxx.railway.app
# DB_USER=root
# DB_PASS=your-railway-password
# DB_NAME=railway
# DB_PORT=7432

# Option 4: Aiven MySQL (Free Tier)
# https://aiven.io/
# DB_HOST=mysql-xxx.aivencloud.com
# DB_USER=avnadmin
# DB_PASS=your-aiven-password
# DB_NAME=defaultdb
# DB_PORT=12345

# Vercel Environment (Auto-set by Vercel)
VERCEL=1

# Timezone (Optional)
TZ=Asia/Jakarta

# Session Secret (Optional - untuk JWT jika dibutuhkan)
SESSION_SECRET=your-random-secret-key-here

# API URL (Auto-set oleh Vercel)
# VERCEL_URL akan otomatis terisi
# Contoh: https://your-project.vercel.app
